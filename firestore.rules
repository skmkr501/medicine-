rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['id', 'name', 'relation', 'age'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.relation is string && data.relation.size() <= 64
        && data.age is number && data.age >= 0 && data.age <= 150
        && (!('isArchived' in data) || data.isArchived is bool)
        && (!('archivedAt' in data) || (data.archivedAt is string && data.archivedAt.size() <= 64));
    }

    function isValidMedicine(data) {
      return data.keys().hasAll(['id', 'brandName', 'type', 'schedules', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 128
        && data.type is string && data.type.size() <= 64
        && data.schedules is list && data.schedules.size() <= 10
        && (!('assignedPatientId' in data) || (data.assignedPatientId is string && data.assignedPatientId.size() <= 128))
        && data.status is string && data.status.size() <= 32;
    }

    function isValidDoseLog(data) {
      return data.keys().hasAll(['id', 'medicineId', 'medicineName', 'scheduledDate', 'timeSlot', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.medicineId is string && data.medicineId.size() <= 128
        && data.medicineName is string && data.medicineName.size() <= 128
        && (!('patientId' in data) || (data.patientId is string && data.patientId.size() <= 128))
        && data.scheduledDate is string && data.scheduledDate.size() <= 32
        && data.timeSlot is string && data.timeSlot.size() <= 32
        && (data.status == 'taken' || data.status == 'skipped' || data.status == 'missed');
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['soundEnabled', 'selectedTone'])
        && data.soundEnabled is bool
        && data.selectedTone is string && data.selectedTone.size() <= 64
        && (!('themeMode' in data) || (data.themeMode is string && data.themeMode.size() <= 16))
        && (!('largeFontMode' in data) || data.largeFontMode is bool)
        && (!('language' in data) || (data.language is string && data.language.size() <= 16))
        && (!('emergencyContactName' in data) || (data.emergencyContactName is string && data.emergencyContactName.size() <= 128))
        && (!('emergencyContactPhone' in data) || (data.emergencyContactPhone is string && data.emergencyContactPhone.size() <= 64));
    }

    function isValidHealthRecord(data) {
      return data.keys().hasAll(['id', 'patientId', 'recordDate'])
        && data.id is string && data.id.size() <= 128
        && data.patientId is string && data.patientId.size() <= 128
        && data.recordDate is string && data.recordDate.size() <= 32
        && (!('systolic' in data) || (data.systolic is number && data.systolic >= 40 && data.systolic <= 300))
        && (!('diastolic' in data) || (data.diastolic is number && data.diastolic >= 30 && data.diastolic <= 200))
        && (!('bloodSugar' in data) || (data.bloodSugar is number && data.bloodSugar >= 1 && data.bloodSugar <= 50))
        && (!('sugarType' in data) || (data.sugarType is string && data.sugarType.size() <= 32))
        && (!('weight' in data) || (data.weight is number && data.weight >= 1 && data.weight <= 500))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 256));
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['id', 'doctorName', 'appointmentDate', 'appointmentTime'])
        && data.id is string && data.id.size() <= 128
        && data.doctorName is string && data.doctorName.size() > 0 && data.doctorName.size() <= 128
        && data.appointmentDate is string && data.appointmentDate.size() <= 32
        && data.appointmentTime is string && data.appointmentTime.size() <= 32
        && (!('patientId' in data) || (data.patientId is string && data.patientId.size() <= 128))
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 128))
        && (!('location' in data) || (data.location is string && data.location.size() <= 256))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 512))
        && (!('status' in data) || (data.status is string && data.status.size() <= 32));
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sarashatikmkr501@gmail.com';
    }

    // User Root Document
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow list: if isAdmin();
      allow delete: if false;

      // Patient Profiles Subcollection (Strictly private to the owner)
      match /patients/{patientId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(patientId) && isValidPatient(incoming());
        allow delete: if isOwner(userId) && isValidId(patientId);
      }

      // Medicines Subcollection (Strictly private to the owner)
      match /medicines/{medicineId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(medicineId) && isValidMedicine(incoming());
        allow delete: if isOwner(userId) && isValidId(medicineId);
      }

      // Dose History Logs Subcollection (Strictly private to the owner)
      match /doseLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(logId) && isValidDoseLog(incoming());
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // User Settings Subcollection (Strictly private to the owner)
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingId) && isValidSettings(incoming());
        allow delete: if isOwner(userId) && isValidId(settingId);
      }

      // Health Records Subcollection (Strictly private to the owner)
      match /healthRecords/{recordId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(recordId) && isValidHealthRecord(incoming());
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      // Doctor Appointments Subcollection (Strictly private to the owner)
      match /appointments/{appointmentId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(appointmentId) && isValidAppointment(incoming());
        allow delete: if isOwner(userId) && isValidId(appointmentId);
      }
    }

    // Collection Group for Admin Patient Stats (Read-only aggregate for authorized admin)
    match /{path=**}/patients/{patientId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    function isValidGlobalMedicine(data) {
      return data.keys().hasAll(['id', 'brandName', 'genericName', 'strength', 'dosageForm', 'manufacturer', 'source', 'duplicateKey'])
        && data.id is string && data.id.size() <= 128
        && data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 128
        && data.genericName is string && data.genericName.size() > 0 && data.genericName.size() <= 256
        && data.strength is string && data.strength.size() <= 64
        && data.dosageForm is string && data.dosageForm.size() <= 64
        && data.manufacturer is string && data.manufacturer.size() <= 128
        && data.source is string && data.source.size() <= 64
        && data.duplicateKey is string && data.duplicateKey.size() <= 256;
    }

    function isValidImportBatch(data) {
      return data.keys().hasAll(['id', 'source', 'importedAt', 'importedByEmail', 'licenseReference', 'totalRecordsInFile'])
        && data.id is string && data.id.size() <= 128
        && data.importedByEmail == 'sarashatikmkr501@gmail.com'
        && data.licenseReference is string && data.licenseReference.size() <= 256;
    }

    // Global Medicine Catalog Collection
    match /global_medicines/{medicineId} {
      // 1. General users can read published medicines (single-field query support without requiring composite index)
      // 2. Draft/unpublished records can ONLY be read by authorized Admin
      allow get: if isAdmin() || resource.data.status == 'published';
      allow list: if isAdmin() || resource.data.status == 'published';

      // Authorized Admin can create or update medicines
      allow create: if isAdmin() && isValidId(medicineId) && isValidGlobalMedicine(incoming());
      allow update: if isAdmin() && isValidId(medicineId);

      // Only authorized Admin can delete, and ONLY if it is a draft or test data (never published real medicine)
      allow delete: if isAdmin() && isValidId(medicineId) && (
        resource.data.status != 'published' ||
        resource.data.verifiedByAdmin != true ||
        resource.data.brandName.matches('.*\\(TEST DATA\\).*') ||
        (resource.data.darNumber is string && resource.data.darNumber.matches('^TEST-.*'))
      );
    }

    // Admin Import Batches and Audit Trail (Admin only read & write)
    match /import_batches/{batchId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(batchId) && isValidImportBatch(incoming());
      allow delete: if isAdmin() && isValidId(batchId);
    }

    // Admin Activities & Audit Logs (Admin only read & write)
    match /admin_activities/{activityId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(activityId);
      allow delete: if isAdmin() && isValidId(activityId);
    }

    function isValidLibraryMeta(data) {
      return data.keys().hasAll(['version', 'chunkCount', 'totalCount', 'updatedAt'])
        && data.keys().hasOnly(['version', 'chunkCount', 'totalCount', 'updatedAt'])
        && data.version is number && data.version >= 1
        && data.chunkCount is number && data.chunkCount >= 0 && data.chunkCount <= 500
        && data.totalCount is number && data.totalCount >= 0
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidLibraryChunk(data) {
      return data.keys().hasAll(['version', 'index', 'items'])
        && data.keys().hasOnly(['version', 'index', 'items'])
        && data.version is number && data.version >= 1
        && data.index is number && data.index >= 0 && data.index <= 500
        && data.items is list && data.items.size() <= 200
        && (data.items.size() == 0 || data.items[0] is map);
    }

    // Versioned Library Metadata (Everyone can read, strictly Admin can write)
    match /library_meta/{metaId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(metaId) && isValidLibraryMeta(incoming());
      allow delete: if isAdmin() && isValidId(metaId);
    }

    // Versioned Library Chunks (Everyone can read, strictly Admin can write)
    match /library_chunks/{chunkId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(chunkId) && isValidLibraryChunk(incoming());
      allow delete: if isAdmin() && isValidId(chunkId);
    }

    // =========================================================================
    // পরিবারের যত্নকারী (Caregiver Mode) — নিরাপত্তা বিধি
    // =========================================================================

    function isValidCaregiverLinkShape(data) {
      return data.keys().hasAll([
          'id', 'inviteCode', 'patientUid', 'patientName', 'caregiverUid',
          'caregiverName', 'status', 'allowFullView', 'expiresAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'inviteCode', 'patientUid', 'patientName', 'patientPhone', 'caregiverUid',
          'caregiverName', 'status', 'allowFullView', 'expiresAtMs', 'createdAt',
          'linkedAt', 'updatedAt', 'todaySummary', 'sharedMedicines'
        ])
        && data.id is string && data.id.matches('^[A-Z0-9]{6}$')
        && data.inviteCode == data.id
        && data.patientUid is string && data.patientUid.size() > 0 && data.patientUid.size() <= 128
        && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 128
        && (!('patientPhone' in data) || (data.patientPhone is string && data.patientPhone.size() <= 32))
        && data.caregiverUid is string && data.caregiverUid.size() <= 128
        && data.caregiverName is string && data.caregiverName.size() <= 128
        && data.status in ['pending', 'active']
        && data.allowFullView is bool
        && data.expiresAtMs is number && data.expiresAtMs > 0
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('linkedAt' in data) || (data.linkedAt is string && data.linkedAt.size() <= 64))
        && (!('todaySummary' in data) || data.todaySummary is map)
        && (!('sharedMedicines' in data) || (
          data.sharedMedicines is list &&
          data.sharedMedicines.size() <= 40 &&
          (data.allowFullView == true || data.sharedMedicines.size() == 0)
        ));
    }

    function isValidCaregiverLinkCreate(data, linkId) {
      return isValidCaregiverLinkShape(data)
        && data.id == linkId
        && data.patientUid == request.auth.uid
        && data.caregiverUid == ''
        && data.caregiverName == ''
        && data.status == 'pending'
        && data.allowFullView == false
        && data.expiresAtMs > request.time.toMillis()
        && data.expiresAtMs <= request.time.toMillis() + 259200000;
    }

    function isLinkedActiveCaregiver(linkId, pUid, cUid) {
      return linkId is string
        && linkId.matches('^[A-Z0-9]{6}$')
        && exists(/databases/$(database)/documents/caregiver_links/$(linkId))
        && get(/databases/$(database)/documents/caregiver_links/$(linkId)).data.patientUid == pUid
        && get(/databases/$(database)/documents/caregiver_links/$(linkId)).data.caregiverUid == cUid
        && get(/databases/$(database)/documents/caregiver_links/$(linkId)).data.status == 'active';
    }

    function allCaregiversVerified(data) {
      return data.caregiverUids is list
        && data.caregiverLinkIds is list
        && data.caregiverUids.size() >= 1
        && data.caregiverUids.size() <= 3
        && data.caregiverLinkIds.size() == data.caregiverUids.size()
        && isLinkedActiveCaregiver(data.caregiverLinkIds[0], data.patientUid, data.caregiverUids[0])
        && (data.caregiverUids.size() < 2 || isLinkedActiveCaregiver(data.caregiverLinkIds[1], data.patientUid, data.caregiverUids[1]))
        && (data.caregiverUids.size() < 3 || isLinkedActiveCaregiver(data.caregiverLinkIds[2], data.patientUid, data.caregiverUids[2]));
    }

    function isValidFamilyAlertShape(data, alertId) {
      return data.keys().hasAll([
          'id', 'patientUid', 'caregiverUids', 'caregiverLinkIds', 'type',
          'medicineName', 'message', 'createdAt', 'createdAtMs', 'seenBy'
        ])
        && data.keys().hasOnly([
          'id', 'patientUid', 'caregiverUids', 'caregiverLinkIds', 'type',
          'medicineId', 'medicineName', 'slot', 'date', 'message',
          'patientName', 'patientPhone', 'createdAt', 'createdAtMs', 'seenBy'
        ])
        && data.id == alertId
        && isValidId(alertId)
        && data.patientUid is string && data.patientUid.size() > 0 && data.patientUid.size() <= 128
        && data.type in ['missed_dose', 'low_stock']
        && (!('medicineId' in data) || (data.medicineId is string && data.medicineId.size() <= 128))
        && data.medicineName is string && data.medicineName.size() > 0 && data.medicineName.size() <= 128
        && (!('slot' in data) || (data.slot is string && data.slot.size() <= 32))
        && (!('date' in data) || (data.date is string && data.date.size() <= 32))
        && data.message is string && data.message.size() > 0 && data.message.size() <= 512
        && (!('patientName' in data) || (data.patientName is string && data.patientName.size() <= 128))
        && (!('patientPhone' in data) || (data.patientPhone is string && data.patientPhone.size() <= 32))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdAtMs is number && data.createdAtMs > 0
        && data.seenBy is list && data.seenBy.size() <= 5;
    }

    function isValidFamilyAlertCreate(data, alertId) {
      return isValidFamilyAlertShape(data, alertId)
        && data.patientUid == request.auth.uid
        && data.seenBy.size() == 0;
    }

    match /caregiver_links/{linkId} {
      // Single-doc lookup allowed for owner, linked caregiver, or pending invite holder who knows exact 6-char code
      allow get: if isSignedIn() && isValidId(linkId) && (
        existing().patientUid == request.auth.uid ||
        existing().caregiverUid == request.auth.uid ||
        (existing().status == 'pending' && request.time.toMillis() < existing().expiresAtMs)
      );
      // Queries strictly scoped to own links only (never allows listing pending invites)
      allow list: if isSignedIn() && (
        existing().patientUid == request.auth.uid ||
        existing().caregiverUid == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(linkId) && isValidCaregiverLinkCreate(incoming(), linkId);
      allow update: if isSignedIn() && isValidId(linkId) && isValidCaregiverLinkShape(incoming()) && (
        // Case 1: Patient updates todaySummary or toggles allowFullView (immutable identity fields preserved)
        (
          existing().patientUid == request.auth.uid &&
          incoming().patientUid == existing().patientUid &&
          incoming().caregiverUid == existing().caregiverUid &&
          incoming().status == existing().status &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'patientName', 'patientPhone', 'allowFullView', 'todaySummary', 'sharedMedicines', 'updatedAt'
          ])
        ) ||
        // Case 2: Caregiver redeems pending unexpired invite once
        (
          existing().status == 'pending' &&
          existing().patientUid != request.auth.uid &&
          request.time.toMillis() < existing().expiresAtMs &&
          incoming().patientUid == existing().patientUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'caregiverUid', 'caregiverName', 'status', 'linkedAt', 'updatedAt'
          ]) &&
          incoming().caregiverUid == request.auth.uid &&
          incoming().caregiverName.size() > 0 &&
          incoming().status == 'active'
        )
      );
      allow delete: if isSignedIn() && isValidId(linkId) && (
        existing().patientUid == request.auth.uid ||
        existing().caregiverUid == request.auth.uid
      );
    }

    match /family_alerts/{alertId} {
      allow get: if isSignedIn() && isValidId(alertId) && (
        existing().patientUid == request.auth.uid ||
        request.auth.uid in existing().caregiverUids
      );
      allow list: if isSignedIn() && (
        existing().patientUid == request.auth.uid ||
        request.auth.uid in existing().caregiverUids
      );
      allow create: if isSignedIn()
        && isValidId(alertId)
        && isValidFamilyAlertCreate(incoming(), alertId)
        && allCaregiversVerified(incoming());
      allow update: if isSignedIn()
        && isValidId(alertId)
        && isValidFamilyAlertShape(incoming(), alertId)
        && (request.auth.uid in existing().caregiverUids)
        && incoming().patientUid == existing().patientUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtMs == existing().createdAtMs
        && incoming().diff(existing()).affectedKeys().hasOnly(['seenBy'])
        && incoming().seenBy.hasAll(existing().seenBy)
        && (request.auth.uid in incoming().seenBy);
      // Patient can clean up alerts >= 30 days old (2,592,000,000 ms)
      allow delete: if isSignedIn()
        && isValidId(alertId)
        && existing().patientUid == request.auth.uid
        && existing().createdAtMs is number
        && (request.time.toMillis() - existing().createdAtMs) >= 2592000000;
    }

    // =========================================================================
    // ডাক্তার / পরিবারের জন্য রিপোর্ট শেয়ার লিংক (shared_reports) — নিরাপত্তা বিধি
    // =========================================================================

    function isValidSharedReportToken(token) {
      return token is string
        && token.size() >= 20
        && token.size() <= 128
        && token.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSharedReport(data, tokenId) {
      return data.keys().hasAll([
          'ownerUid', 'token', 'createdAt', 'expiresAt', 'patientName', 'sections', 'revoked'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'token', 'createdAt', 'expiresAt', 'patientName',
          'age', 'gender', 'relation', 'sections', 'revoked'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.token is string && data.token == tokenId && isValidSharedReportToken(data.token)
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 128
        && (!('age' in data) || (data.age is number && data.age >= 0 && data.age <= 150))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 32))
        && (!('relation' in data) || (data.relation is string && data.relation.size() <= 64))
        && data.sections is map
        && data.revoked is bool;
    }

    match /shared_reports/{token} {
      // Anyone holding the exact unguessable >=20-char token can fetch ONE document if active & unexpired
      allow get: if isValidSharedReportToken(token)
        && resource.data.revoked == false
        && resource.data.expiresAt > request.time;

      // Only authenticated owner can list their own shared links
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Only logged-in owner can create; token >= 20 chars; expiry strictly <= 90 days
      allow create: if isSignedIn()
        && isValidSharedReportToken(token)
        && isValidSharedReport(incoming(), token)
        && incoming().ownerUid == request.auth.uid
        && incoming().revoked == false
        && incoming().createdAt == request.time
        && incoming().expiresAt > request.time
        && incoming().expiresAt <= request.time + duration.value(90, 'd');

      // Only owner can update, and ONLY the `revoked` field can be set to true
      allow update: if isSignedIn()
        && isValidSharedReportToken(token)
        && isValidSharedReport(incoming(), token)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().token == existing().token
        && incoming().createdAt == existing().createdAt
        && incoming().expiresAt == existing().expiresAt
        && incoming().patientName == existing().patientName
        && incoming().sections == existing().sections
        && incoming().diff(existing()).affectedKeys().hasOnly(['revoked'])
        && incoming().revoked == true;

      // Only owner can delete their shared report link
      allow delete: if isSignedIn()
        && isValidSharedReportToken(token)
        && existing().ownerUid == request.auth.uid;
    }
  }
}

